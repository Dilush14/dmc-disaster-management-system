{
  "expo": {
    "name": "DMC Sri Lanka",
    "slug": "dmc-sri-lanka",
    "scheme": "dmc",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DMC uses your location to place hazard reports accurately.",
        "NSCameraUsageDescription": "DMC uses your camera to attach evidence to a hazard report.",
        "NSPhotoLibraryUsageDescription": "DMC uses your photos to attach evidence to a hazard report."
      }
    },
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "CAMERA", "READ_MEDIA_IMAGES"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
